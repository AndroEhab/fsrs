{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "region": "us-central1",
    "ignore": [
      "node_modules",
      ".git",
      "*.log",
      "*.test.ts",
      ".tmp"
    ],
    "predeploy": [
      "npm --prefix functions run build"
    ],
    "environmentVariables": {
      "NODE_ENV": "production"
    }
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node scripts/firestore-deploy-guard.cjs"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
