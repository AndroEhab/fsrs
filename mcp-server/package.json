{
  "name": "fsrs-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server (ChatGPT Apps SDK platform) bridging ChatGPT to the deployed FSRS flashcard Firebase Functions API. Tools: create/list/get/update/delete flashcard + health.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:stdio": "node --env-file-if-exists=.env scripts/launch-local.mjs stdio",
    "start:http:local": "node --env-file-if-exists=.env scripts/launch-local.mjs http",
    "dev": "npm run build && node --env-file-if-exists=.env dist/index.js",
    "test": "jest",
    "smoke": "npm run build && node scripts/smoke.mjs && node scripts/check-widget-runtime.mjs",
    "smoke:forwarded-token": "npm run build && node scripts/forwarded-token-smoke.mjs",
    "inspect":"npx @modelcontextprotocol/inspector@latest",
    "preview":"npm run build && node scripts/widget-preview.mjs",
    "preview:watch":"npm run build && node scripts/widget-preview.mjs --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "jsdom": "30.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
