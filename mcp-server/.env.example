# Copy to .env (gitignored) and fill in. NEVER commit real values.

# Required in production: the API key for the deployed Firebase backend.
# Sent as the X-API-Key header. The backend enforces it on any non-emulator
# runtime (FUNCTIONS_EMULATOR unset); local emulator/dev servers leave auth
# open, so this may be empty when pointing FSRS_API_BASE_URL at the emulator
# or the chatgpt mock server.
#
# ROTATION: add a new apiKeys document in Firestore (doc id = the key value,
# fields: name, revoked: false), update the Cloud Run cuelingua-api-key
# secret to the new value, then delete or revoke the old document.
CUELINGUA_API_KEY=

# Deployed Firebase Functions base URL (default). Point at the emulator
# (http://127.0.0.1:5001/cuelingua/us-central1) or the chatgpt mock
# (http://127.0.0.1:8787) for local development.
FSRS_API_BASE_URL=https://us-central1-cuelingua.cloudfunctions.net

# HTTP server binding. MCP_PORT falls back to PORT (Cloud Run convention).
MCP_PORT=8787
MCP_HOST=0.0.0.0

# Transport: "http" (default, Streamable HTTP at /mcp) or "stdio".
MCP_TRANSPORT=http

# Optional Bearer token gate for the /mcp endpoint (defense in depth when
# exposing via a tunnel). Counts as an auth mechanism for the deploy-time
# guard (see AUTH0 note below). Leave empty for ChatGPT dev-mode connections
# (ChatGPT's connector uses OAuth, not a static Bearer header).
# MCP_AUTH_TOKEN=

# Deploy-time auth guard: an HTTP server targeting a REMOTE backend refuses to
# start without Auth0 (below) or MCP_AUTH_TOKEN. Set MCP_AUTH_OPT_OUT=true ONLY
# for a local desktop connector / tunnel (never a public deployment) — the
# launch-local scripts do this automatically.
# MCP_AUTH_OPT_OUT=

# Fetch timeout against the Firebase backend, in ms.
FSRS_REQUEST_TIMEOUT_MS=15000

# Auth0 (optional): when both are set, the HTTP /mcp endpoint requires a valid
# RS256 access token from the Auth0 tenant (verified via JWKS). The stdio
# transport is unaffected and remains usable without Auth0. See README for
# Auth0 tenant setup prerequisites.
AUTH0_ISSUER=https://andrewehab.eu.auth0.com/
AUTH0_AUDIENCE=https://cuelingua-mcp-767542644824.us-central1.run.app/mcp

# Public URL of this MCP resource (the /mcp endpoint). Used in RFC 9728
# protected-resource metadata and the WWW-Authenticate challenge.
MCP_RESOURCE_URL=https://cuelingua-mcp-767542644824.us-central1.run.app/mcp
