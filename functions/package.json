{
  "name": "fsrs-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --project demo-fsrs-local --only functions,firestore,storage",
    "shell": "npm run build && firebase emulators:exec --project demo-fsrs-local --only firestore,storage \"firebase functions:shell --project demo-fsrs-local\"",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src/",
    "test": "jest --passWithNoTests",
    "test:rules": "node scripts/run-firestore-emulator-tests.cjs rules",
    "test:datastore": "node scripts/run-firestore-emulator-tests.cjs datastore"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "jszip": "^3.10.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.56.0",
    "firebase": "^12.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1",
    "qs": "6.16.1"
  }
}
