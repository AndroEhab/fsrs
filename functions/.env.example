# Runtime configuration for the deployed Cloud Functions.
#
# firebase-tools loads this file into EVERY `firebase deploy --only functions`
# run (it prints "Loaded environment variables from .env"), so this file is
# PRODUCTION configuration, not a local scratchpad. Keep it in the state you
# want deployed; never leave a temporary testing flag enabled here.
#
# REVIEW_TEST_MODE (temporary widget-testing mode) - MUST be false/unset for
# normal deployments. When true: startReviewSession queues ALL cards (a query
# override, no card mutations) and submitSessionReview advances the session
# but SKIPS the card FSRS scheduling / reviewLog / reviewEvents writes - real
# reviews would silently not be scheduled while it is on. Enable only for
# widget testing via `gcloud functions deploy ... --set-env-vars
# REVIEW_TEST_MODE=true`, never by leaving it in this file.
REVIEW_TEST_MODE=false

# ---------------------------------------------------------------------------
# Multi-tenant identity configuration (REQUIRED for production, fail-closed).
# ---------------------------------------------------------------------------
# The backend now requires BOTH a valid X-API-Key AND a valid Auth0 RS256
# Bearer JWT on every production-like (non-emulator) user request. The
# verified JWT `sub` becomes the request ownerId; every read/write is scoped
# to it. Without these variables every production request 401s with
# "Authentication is not configured" (fail-closed) — set them BEFORE the
# first multi-tenant deploy, and keep them in sync with the mcp-server's
# AUTH0_ISSUER / AUTH0_AUDIENCE so the same audience token verifies at both
# hops (the MCP server forwards the verified token as Authorization).
#
# AUTH0_ISSUER: the Auth0 tenant issuer URL (e.g. https://tenant.eu.auth0.com/).
# AUTH0_AUDIENCE: the API audience the functions' access tokens are minted for
#   (must match what the MCP server / clients request).
# AUTH0_OPERATOR_SUBS: comma-separated EXACT Auth0 `sub` values allowed to run
#   operator-only routes (POST /migrateDecksHandler,
#   POST /migrateReviewEventsHandler). Leave empty to deny all operators.
#
# NOTE: firebase-tools loads this file into every `firebase deploy` — keep the
# values here as the deployed production state. Use gcloud functions deploy
# --set-env-vars for one-off overrides.
#
# AUTH0_ISSUER=
# AUTH0_AUDIENCE=
# AUTH0_OPERATOR_SUBS=
