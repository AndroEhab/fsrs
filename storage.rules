rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Card image uploads live under card-images/{cardId}/...
    // Objects are PRIVATE: clients may only read via short-lived signed URLs
    // generated by the backend (uploadImage) — never by guessing paths.
    // Writes are admin-only via the backend (admin SDK bypasses rules).
    match /card-images/{cardId}/{fileName} {
      allow read: if false;
      allow write: if false;
    }

    // Everything else is private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
